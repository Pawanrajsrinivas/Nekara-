rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // HELPER FUNCTIONS
    // =========================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        (
          exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active != false &&
          get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['admin', 'superadmin']
        )
      );
    }

    function isValidWeavingType(data) {
      return !('weavingType' in data) || data.weavingType in ['Powerloom', 'Handloom'];
    }

    function isCustomerOrderHideOnlyUpdate() {
      return isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['hiddenForCustomer', 'deletedByCustomerAt', 'updatedAt'])
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.totalAmount == resource.data.totalAmount
        && request.resource.data.paymentStatus == resource.data.paymentStatus;
    }

    // =========================================================
    // 1. ADMIN ACCOUNTS (/admins/{uid})
    // =========================================================
    match /admins/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false; // Managed strictly via Firebase Admin SDK / Console
    }

    // =========================================================
    // 2. PRODUCTS (/products/{productId})
    // Public storefront read; Admin-only create/update/delete.
    // =========================================================
    match /products/{productId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidWeavingType(request.resource.data);
      allow delete: if isAdmin();
    }

    // =========================================================
    // 3. CATEGORIES & SUBCATEGORIES
    // Public storefront read; Admin-only create/update/delete.
    // =========================================================
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /subcategories/{subcategoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // =========================================================
    // 4. HOMEPAGE SECTIONS (/homeSections/{sectionId})
    // Public storefront read; Admin-only create/update/delete.
    // =========================================================
    match /homeSections/{sectionId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // =========================================================
    // 5. COUNTERS & MEDIA (/counters/{id}, /media/{id})
    // Admin-only access for SKU sequence generation and media assets.
    // =========================================================
    match /counters/{counterId} {
      allow read, write: if isAdmin();
    }

    match /media/{mediaId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // =========================================================
    // 6. SETTINGS (/settings/{settingId})
    // Admin-only write; authenticated/admin read for configuration.
    // =========================================================
    match /settings/{settingId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // =========================================================
    // 7. USER PROFILES (/users/{userId})
    // Owner can read/write their own profile but cannot self-assign admin roles.
    // =========================================================
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && !('role' in request.resource.data)
        && !('isAdmin' in request.resource.data);
      allow update: if (
        isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isAdmin'])
      ) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();

      match /addresses/{addressId} {
        allow read, create, update, delete: if isOwner(userId) || isAdmin();
      }

      match /wishlist/{itemId} {
        allow read, create, update, delete: if isOwner(userId) || isAdmin();
      }
    }

    // =========================================================
    // 8. SHOPPING CARTS & WISHLISTS (/carts/{userId}, /wishlists/{userId})
    // Strict owner isolation.
    // =========================================================
    match /carts/{userId} {
      allow read, create, update, delete: if isOwner(userId) || isAdmin();

      match /items/{itemId} {
        allow read, create, update, delete: if isOwner(userId) || isAdmin();
      }
    }

    match /wishlists/{userId} {
      allow read, create, update, delete: if isOwner(userId) || isAdmin();

      match /items/{itemId} {
        allow read, create, update, delete: if isOwner(userId) || isAdmin();
      }
    }

    // =========================================================
    // 9. ORDERS (/orders/{orderId})
    // - Customers can read only their own orders (resource.data.userId == request.auth.uid).
    // - Customers can only soft-hide their own order (hiddenForCustomer) and can NEVER
    //   forge paymentStatus = "Paid", modify refund records, or alter order totals.
    // - Authoritative order creation, Razorpay verification, stock deduction, and
    //   refund processing run on the server via Firebase Admin SDK.
    // - Admins have full read/update/delete access for fulfillment & management.
    // =========================================================
    match /orders/{orderId} {
      allow get, list: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create: if isAdmin();
      allow update: if isAdmin() || isCustomerOrderHideOnlyUpdate();
      allow delete: if isAdmin();
    }

    // =========================================================
    // 10. DEFAULT DENY FALLBACK
    // =========================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
